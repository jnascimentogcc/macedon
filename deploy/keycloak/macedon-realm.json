{
  "realm": "macedon",
  "enabled": true,
  "registrationAllowed": false,
  "groups": [
    { "name": "engineering" },
    { "name": "legal" }
  ],
  "roles": {
    "realm": [
      { "name": "admin", "description": "Can manage every document" },
      { "name": "user", "description": "Regular platform user" }
    ]
  },
  "clients": [
    {
      "clientId": "macedon-web",
      "name": "Macedon frontend",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["http://localhost:4200/*"],
      "webOrigins": ["http://localhost:4200"],
      "attributes": { "pkce.code.challenge.method": "S256" },
      "protocolMappers": [
        {
          "name": "macedon-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "macedon-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        },
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "config": {
            "claim.name": "groups",
            "full.path": "false",
            "id.token.claim": "true",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "alice",
      "enabled": true,
      "email": "alice@example.test",
      "emailVerified": true,
      "firstName": "Alice",
      "lastName": "Admin",
      "credentials": [{ "type": "password", "value": "alice-dev", "temporary": false }],
      "realmRoles": ["admin", "user"],
      "groups": ["/engineering"]
    },
    {
      "username": "bob",
      "enabled": true,
      "email": "bob@example.test",
      "emailVerified": true,
      "firstName": "Bob",
      "lastName": "User",
      "credentials": [{ "type": "password", "value": "bob-dev", "temporary": false }],
      "realmRoles": ["user"],
      "groups": ["/legal"]
    }
  ]
}
