# Copy to backend/.env (ignored by git) and fill in. Settings are read from the working
# directory, so run the API and the worker from backend/. Every variable needs the MACEDON_
# prefix: a plain OPENAI_API_KEY is ignored.

# Required for ingestion (embeddings) and for /query (embeddings + answer generation).
MACEDON_OPENAI_API_KEY=

# Optional overrides; the defaults match docker-compose.yml.
# MACEDON_LLM_MODEL=gpt-6.1-terra
# MACEDON_EMBEDDING_MODEL=text-embedding-3-large
# MACEDON_DATABASE_URL=postgresql+asyncpg://macedon_app:macedon_app@127.0.0.1:5432/macedon
# MACEDON_QUERY_RATE_LIMIT_PER_MINUTE=30
